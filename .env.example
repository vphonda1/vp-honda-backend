# VP Honda Backend — Environment Variables
# Copy this to .env and fill values

# MongoDB Connection
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/vphonda?retryWrites=true&w=majority

# Port (Render will auto-set this)
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://vp-honda.vercel.app

# For local development:
# MONGODB_URI=mongodb://localhost:27017/vphonda
# FRONTEND_URL=http://localhost:5173
